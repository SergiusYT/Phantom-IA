#!/bin/sh
# PHANTOM AI - monitor en vivo del firewall (correr en la VM FreeBSD como root).
# Muestra en español, a medida que pasa:
#   - cada conexión nueva que PF deja pasar o bloquea (pflog0)
#   - cada vez que un agente o el controlador entra por SSH (auth.log)
#   - cada cambio que aplica el controlador en el anchor "phantom" (phantom-pf.log)
# Salir con Ctrl+C.

V=$(printf '\033[1;32m'); R=$(printf '\033[1;31m'); A=$(printf '\033[1;33m')
C=$(printf '\033[1;36m'); G=$(printf '\033[0;90m'); B=$(printf '\033[1m'); N=$(printf '\033[0m')
KEYS=/root/.ssh/authorized_keys

clear 2>/dev/null
echo "${V}${B}PHANTOM AI${N} · monitor del firewall FreeBSD/PF   ${G}(Ctrl+C para salir)${N}"
echo "${G}──────────────────────────────────────────────────────────────────────${N}"
pfctl -si 2>/dev/null | awk -v g="$G" -v n="$N" 'NR==1{print g "PF: " $1 " " $2 n}'
echo "${G}Puertos permitidos: 22 (gestión) · 80/443 (web → clúster) · 8081 (prueba). Todo lo demás: bloqueado.${N}"
reglas=$(pfctl -a phantom -sr 2>/dev/null)
if [ -n "$reglas" ]; then echo "${C}Reglas agregadas por PHANTOM:${N}"; echo "$reglas" | sed 's/^/  /'
else echo "${G}Anchor phantom vacío: estado inicial del laboratorio.${N}"; fi
echo "${G}──────────────────────────────────────────────────────────────────────${N}"
printf '%s%-8s %-9s %-16s %-24s %s%s\n' "$G" HORA ACCIÓN ORIGEN DESTINO DETALLE "$N"

trap 'kill 0 2>/dev/null; echo; exit 0' INT TERM

# 1) Tráfico: solo el primer paquete de cada conexión (SYN) para que se lea fácil.
tcpdump -n -l -e -tttt -i pflog0 2>/dev/null | awk -v v="$V" -v r="$R" -v g="$G" -v c="$C" -v n="$N" '
  function servicio(p) {
    if (p == 22) return "SSH de gestión"; if (p == 80) return "web"; if (p == 443) return "web segura";
    if (p == 8081) return "puerto de prueba"; if (p == 30080) return "app (NodePort)"; return "puerto no autorizado"
  }
  /Flags \[S\],/ {
    hora = substr($2, 1, 8); accion = $5; src = $9; dst = $11; sub(/:$/, "", dst)
    ip = src; sub(/\.[0-9]+$/, "", ip); port = dst; sub(/^.*\./, "", port)
    extra = ($4 ~ /phantom/) ? c " ← regla PHANTOM" n : ""
    color = (accion == "block") ? r : v; texto = (accion == "block") ? "BLOQUEA" : "PASA"; det = servicio(port + 0)
    if (accion == "rdr") { if (port == 30080) next; texto = "REENVÍA"; det = "web → clúster k3d (172.16.97.1:30080)" }
    printf "%s %s%-9s%s %-16s %-24s %s%s\n", hora, color, texto, n, ip, "→ :" port, det, extra
    fflush()
  }' &

# 2) Accesos SSH: quién entra (agente de solo lectura, controlador o administrador).
tail -n 0 -F /var/log/auth.log 2>/dev/null | awk -v keys="$KEYS" -v a="$A" -v g="$G" -v n="$N" '
  BEGIN { cmd = "ssh-keygen -lf " keys
          while ((cmd | getline l) > 0) { split(l, f, " "); quien = "administrador"
            if (l ~ /phantom-agent-ro/) quien = "agente recolector (solo lectura)"
            if (l ~ /phantom-controller/) quien = "controlador (escritura)"
            nombre[f[2]] = quien }
          close(cmd) }
  /Accepted publickey/ {
    hora = $3; ip = ""; for (i = 1; i <= NF; i++) if ($i == "from") ip = $(i + 1)
    q = nombre[$NF]; if (q == "") q = "llave desconocida"
    printf "%s %s%-9s%s %-16s %-24s %s\n", hora, a, "SSH", n, ip, "→ :22", "entra el " q
    fflush()
  }' &

# 3) Cambios del controlador en el anchor "phantom".
tail -n 0 -F /var/log/phantom-pf.log 2>/dev/null | awk -v c="$C" -v r="$R" -v g="$G" -v n="$N" '
  {
    "date +%H:%M:%S" | getline hora; close("date +%H:%M:%S"); op = $2; arg = $3; ro = $4; res = $5
    sub(/^op=/, "", op); sub(/^arg=/, "", arg); sub(/^result=/, "", res)
    accion["block-port"] = "bloquear el puerto " arg; accion["unblock-port"] = "desbloquear el puerto " arg
    accion["restore"] = "restaurar el respaldo"; accion["reset-lab"] = "vaciar el anchor (estado inicial)"
    a = (op in accion) ? accion[op] : op
    if (ro == "ro=1") printf "%s %s%-9s%s el agente de solo lectura intentó %s: denegado\n", hora, r, "RECHAZO", n, a
    else printf "%s %s%-9s%s el controlador ordena %s → %s\n", hora, c, "CAMBIO", n, a, res
    fflush()
  }' &

wait
