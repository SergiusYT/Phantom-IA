# Copiar a .env y ajustar. Nunca subir .env al repositorio.
PHANTOM_SECRET_KEY=cambia-esto-por-una-cadena-larga-aleatoria
PHANTOM_DB_PASSWORD=cambia-esto
PHANTOM_ADMIN_PASSWORD=phantom-admin
PHANTOM_VIEWER_PASSWORD=phantom-viewer
PHANTOM_NAMESPACE=phantom-demo
PHANTOM_PF_HOST=172.16.97.132
PHANTOM_PF_USER=root
PHANTOM_PF_ALLOWED_PORTS=22,80,443
PHANTOM_OLLAMA_URL=http://127.0.0.1:11434
PHANTOM_OLLAMA_MODEL=mistral
PHANTOM_LLM=1
# Agentes orquestados por Kubernetes (cada agente es un Job en phantom-agents)
PHANTOM_AGENTS_MODE=k8s
PHANTOM_AGENT_API=http://172.18.0.1:8001
# IA de los agentes. Por defecto, Ollama dentro del cluster (CPU).
# Respaldo rapido (GPU del host): http://172.18.0.1:11434 -> requiere OLLAMA_HOST=0.0.0.0 en el
# servicio systemd del host y permitir egress 172.18.0.1/32:11434 en infra/k8s/agents.yaml.
PHANTOM_AGENT_OLLAMA_URL=http://ollama.phantom-ai:11434
